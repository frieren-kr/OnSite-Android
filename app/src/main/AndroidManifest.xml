<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 서버(로그인, 프로젝트 API)와 통신하려면 필요. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 지오펜스는 정밀 위치(FINE)가 있어야 등록된다. COARSE는 FINE과 함께 요청해야 한다(Android 12+ 규칙). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 앱이 꺼져 있을 때도 지오펜스 이벤트를 받으려면 필요 (Android 10+). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Android 13+에서 알림을 띄우려면 필요. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OnSiteApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnSite">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OnSite"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Play services가 우리 앱의 PendingIntent로 직접 호출하므로 외부 공개(exported)가 필요 없다. -->
        <receiver
            android:name=".feature.geofence.GeofenceBroadcastReceiver"
            android:exported="false" />
    </application>

</manifest>
