<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+(API 31+)의 백업(cloud-backup)·기기 이전(device-transfer) 규칙.
    로그인 토큰 DataStore 파일을 둘 다에서 제외한다. 이유는 backup_rules.xml 주석 참고.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
